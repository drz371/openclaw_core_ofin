# 测试环境 Dockerfile
FROM rust:1.75-slim

# 安装测试依赖
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 复制项目文件
COPY . .

# 构建项目
RUN cargo build --release

# 运行测试
CMD ["cargo", "test", "--", "--test-threads=1"]
